{
  "id": "rewind.codex",
  "name": "Codex",
  "version": "1.2.0",
  "description": "Books for Rewind — metadata and free books in one addon. One search across Hardcover, Google Books, Open Library and Audible (Audnexus) for covers, authors, narrators, series, descriptions and chapters; and free, legal copies to read or listen to: public-domain ebooks from Project Gutenberg and the Internet Archive, audiobooks from LibriVox. Powers the Books space.",
  "resources": [
    "search",
    "meta",
    "artwork",
    "catalog",
    "stream",
    "automation"
  ],
  "types": [
    "book",
    "audiobook"
  ],
  "idPrefixes": [
    "codex:"
  ],
  "provides": {
    "content": [
      "books"
    ],
    "metadata": [
      "books"
    ],
    "artwork": [
      "books"
    ]
  },
  "rewind": {
    "kind": "books",
    "sdk": 2,
    "repo": "j4ckgrey/rewind_codex",
    "branch": "main",
    "bundlePath": "dist/index.mjs",
    "bundleUrl": "https://raw.githubusercontent.com/j4ckgrey/rewind_codex/main/dist/index.mjs",
    "tabs": [],
    "configKeys": [
      {
        "key": "codex_hardcover_token",
        "label": "Hardcover API token",
        "category": "Books",
        "card": "codex",
        "description": "Optional, recommended. Best covers, series and ratings. hardcover.app → Settings → Hardcover API (expires every 1 January)."
      },
      {
        "key": "codex_google_books_key",
        "label": "Google Books API key",
        "category": "Books",
        "card": "codex",
        "description": "Optional. Strong for German and other non-English books. Free key from Google Cloud Console → Books API."
      }
    ],
    "features": [
      "books"
    ],
    "automations": [
      {
        "id": "refresh-discover",
        "name": "Refresh book Discover lists",
        "description": "Rebuilds the Books Discover page — trending, bestsellers, new releases and genre shelves — from Open Library and Audible.",
        "intervalMinutes": 10080
      }
    ]
  },
